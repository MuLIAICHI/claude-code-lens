{
  "name": "cc-lens",
  "version": "0.0.0",
  "description": "Lens for Claude Code — local-first viewer and analytics for Claude Code session history.",
  "type": "module",
  "bin": {
    "cc-lens": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "scan": "tsx src/cli/index.ts scan",
    "test": "tsx --test tests/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "26.2.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
